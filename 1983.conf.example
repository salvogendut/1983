# 1983 - generic MSX / MSX2 emulator
# This is the initial frontend-scaffold configuration.

[machine]
model = msx1
hardware = msx1
region = pal
# Supported selections extend through 4096 KiB.
memory_kb = 64

[firmware]
bios =
logo =
subrom =
disk_rom =

[display]
scale = 1
fullscreen = false
smoothing = false
real_crt = false
crt_scanlines = 35

[audio]
audio_volume = 80

[input]
main_input = joy_port_a
joy_port_a = joystick
joy_port_b = joystick

[media]
cartridge1 =
cartridge1_mapper = auto
cartridge2 =
cartridge2_mapper = auto
# Standard MSX CAS image; playback is read-only.
cassette =
# Raw, 512-byte-sector image; currently mounted read-only.
ide_image =
last_media_dir =

[extensions]
extra_hardware = false
second_drive = false
sunrise_ide = false
# Exact 128 KiB Sunrise IDE/Nextor kernel ROM.
sunrise_rom =
scc = false
msx_music = false
kanji_rom = false

[advanced]
tinker = false
# These monitors are active only while Tinker is enabled.
cassette_audible_monitor = false
cassette_visual_monitor = false
debug = false
notifications = screen
