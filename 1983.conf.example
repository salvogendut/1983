# 1983 - generic MSX / MSX2 emulator
# This is the initial frontend-scaffold configuration.

[machine]
model = msx1
hardware = msx1
region = pal
# Supported selections extend through 4096 KiB.
memory_kb = 64

[firmware]
bios =
logo =
subrom =
disk_rom =

[display]
scale = 1
fullscreen = false
smoothing = false
real_crt = false
crt_scanlines = 35

[audio]
audio_volume = 80

[input]
main_input = joy_port_a
joy_port_a = joystick
joy_port_b = joystick

[media]
cartridge1 =
cartridge1_mapper = auto
cartridge2 =
cartridge2_mapper = auto
# Standard MSX CAS image; playback is read-only.
cassette =
# Raw sector-based MSX floppy images.
drive_a =
drive_b =
# read-only (safe default) or read-write; applies to both floppies.
floppy_image_mode = read-only
# Raw, 512-byte-sector image.
ide_image =
# read-only (safe default) or read-write.
ide_image_mode = read-only
# Raw, 512-byte-sector SD-card images for SD Mapper V2.
sd_card_a =
sd_card_b =
# Raw images for the MegaFlashROM SCC+ SD card slots.
megaflash_sd_a =
megaflash_sd_b =
# read-only (safe default) or read-write; applies to both cards.
sd_image_mode = read-only
last_media_dir =

[extensions]
extra_hardware = false
# Adds Floppy B to Media on Philips NMS 8250 machines.
second_drive = false
sunrise_ide = false
# Exact 128 KiB Sunrise IDE/Nextor kernel ROM.
sunrise_rom =
# Composite dual-SD controller and independent 512 KiB mapper cartridge.
sd_mapper = false
# Exact 128 or 256 KiB SD Mapper V2 controller ROM.
sd_mapper_rom =
# Hardware switches; a 256 KiB ROM contains two 128 KiB driver halves.
sd_mapper_ram = true
sd_mapper_alternate_driver = false
# Initial flash image up to 8 MiB. Short images have an erased, padded tail.
# Guest flash changes are stored separately and never overwrite this source.
megaflash = false
megaflash_rom =
scc = false
msx_music = false
kanji_rom = false

[advanced]
tinker = false
# Battery-backed per-machine MSX2 RTC state.
rtc_persistence = true
# These monitors are active only while Tinker is enabled.
cassette_audible_monitor = false
cassette_visual_monitor = false
debug = false
notifications = screen
