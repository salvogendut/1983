install-dist_cbiosDATA: $(dist_cbios_DATA)
	@$(NORMAL_INSTALL)
	@list='$(dist_cbios_DATA)'; test -n "$(cbiosdir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(cbiosdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(cbiosdir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  echo "$$d$$p"; \
	done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(cbiosdir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(cbiosdir)" || exit $$?; \
	done

uninstall-dist_cbiosDATA:
	@$(NORMAL_UNINSTALL)
	@list='$(dist_cbios_DATA)'; test -n "$(cbiosdir)" || list=; \
	files=`for p in $$list; do echo $$p; done | sed -e 's|^.*/||'`; \
	dir='$(DESTDIR)$(cbiosdir)'; $(am__uninstall_files_from_dir)
